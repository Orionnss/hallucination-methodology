# MeluXina, project p201468, for configs/full.yaml. Use with CLUSTER_ENV=<this file>.
# Same settings as cluster.meluxina-smoke.env; only the walltime caps differ, sized from the
# slurm_smoke_001 timings scaled to n = 1000 (about 2× the expected time). Nodes are exclusive:
# each task takes the whole node (4 × A100-40GB), the model spread over the 4 GPUs (D84).
GPU_PARTITION=gpu
CPU_PARTITION=cpu
ACCOUNT=p201468
QOS=short           # ≤ 6 h, no job-count cap ("test" and "dev" allow only one job: arrays stall)
GPUS_PER_TASK=4
CPUS_PER_GPU_TASK=128
MEM_GPU_TASK=480G
CPUS_PER_CPU_TASK=16
MEM_CPU_TASK=60G
TIME_GENERATE=00:30:00   # expected ~10 min
TIME_JUDGE=02:00:00      # gpt-oss-20b (two-phase thinking) ~45 min; the others less
TIME_EXTRACT=02:00:00    # Qwen3-14B ~60–70 min (reducer-bound); resumes by shard of 500
TIME_EVALUATE=03:00:00   # CPU, 5 × 3 CV, ~30–40 min
TIME_SHORT=00:30:00
TIME_PARITY=01:00:00     # not submitted for the full run (no WITH_PARITY)
# Everything large lives in project space: HOME (/mnt/tier2/users/u101970, which also holds the
# repo) is 100 GiB with ~6 GB free. The HF hub cache is shared with the halluc project, which
# already holds gemma-3-12b-it, Qwen3-14B and the three datasets.
HBENCH_BASE=/project/home/p201468/u101970-halluc
UV_PROJECT_ENVIRONMENT=$HBENCH_BASE/hbench/venv
UV_CACHE_DIR=$HBENCH_BASE/.uv-cache
UV_PYTHON_INSTALL_DIR=$HBENCH_BASE/.uv-python
HF_HOME=$HBENCH_BASE/hf-cache
HF_TOKEN_PATH=$HOME/.cache/huggingface/token   # gated Gemma; the token stays in HOME
HF_DATASETS_CACHE=$HBENCH_BASE/hbench/datasets-cache   # D38: not shared with other datasets versions
TOKENIZERS_PARALLELISM=false
# The system /usr/bin/python3.12 has no full headers (no Python.h): Triton cannot build its
# launcher, so the gpt-oss MXFP4 kernels fail. Use a uv-managed Python, which ships them.
UV_PYTHON_PREFERENCE=only-managed
