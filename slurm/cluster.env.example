# Copy to slurm/cluster.env and fill in. Read by slurm/submit_all.sh (passed to sbatch on the command line).
GPU_PARTITION=gpu
CPU_PARTITION=batch
ACCOUNT=            # leave empty if your cluster has no accounts
QOS=                # optional
GPUS_PER_TASK=1     # one 80 GB GPU per array task; a node runs up to 4 tasks
CPUS_PER_GPU_TASK=8
MEM_GPU_TASK=96G
CPUS_PER_CPU_TASK=16
MEM_CPU_TASK=64G
TIME_GENERATE=04:00:00
TIME_JUDGE=08:00:00
TIME_EXTRACT=04:00:00
TIME_EVALUATE=12:00:00
TIME_SHORT=01:00:00
TIME_PARITY=04:00:00
# Caches on a shared filesystem (compute nodes are online, D58)
HF_HOME=$HOME/.cache/huggingface
HF_DATASETS_CACHE=$HOME/.cache/hbench/datasets   # D38
UV_CACHE_DIR=$HOME/.cache/uv
